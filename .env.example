# CSGO server configuration. Never expose these as VITE_* variables.
NODE_ENV=development
PORT=5173
SERVER_PORT=4000
DATABASE_URL=postgresql://csgo:change-me@localhost:5432/csgo
SESSION_SECRET=replace-with-a-long-random-server-secret

# Optional identity providers (provider passwords are never stored)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STEAM_CLIENT_ID=
STEAM_CLIENT_SECRET=

# Server-only moderation notifications
DISCORD_WEBHOOK_URL=
DISCORD_SERVER_INVITE_URL=

SERVER_TICK_RATE=64
MAX_PLAYERS_PER_MATCH=10
ANTI_CHEAT_STRICT_MODE=true
WORKSHOP_MAX_PACKAGE_BYTES=5242880
