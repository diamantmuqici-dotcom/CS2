# Vanguard Protocol — Tactical FPS Environment Configuration
PORT=5173
SERVER_PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL + Redis for production cluster)
DATABASE_URL=postgresql://vanguard:vanguard_secret@localhost:5432/vanguard_protocol
REDIS_URL=redis://localhost:6379

# Authoritative Server Settings
SERVER_TICK_RATE=64
MAX_PLAYERS_PER_MATCH=10
ANTI_CHEAT_STRICT_MODE=true
WORKSHOP_MAX_PACKAGE_BYTES=5242880
JWT_SECRET=vanguard-protocol-authoritative-secret-2026
